{
  "manifest_version": 3,
  "name": "Coursera Video Accelerator + Auto Advance",
  "version": "4.5.2",
  "description": "Speeds up Coursera videos, keeps playback running when switching tabs, automatically skips in-video questions, and advances when Coursera marks the next-item button ready.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.coursera.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.coursera.org/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.coursera.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Coursera Accelerator"
  }
}
